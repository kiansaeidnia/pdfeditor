# Copy to .env and fill in. Docker Compose reads it automatically. Never commit .env.

# Where the app listens. 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (choose a sign-in first).
BIND=127.0.0.1
PORT=8080

# Everything below is optional. Normally you choose the sign-in and mail server in the browser the first time
# pdfeditor starts. Setting AUTH_PASSWORD here instead skips that setup (user name: AUTH_USER).
# Settings saved by the setup win over these.
AUTH_USER=admin
AUTH_PASSWORD=

# Mail server, used only together with AUTH_PASSWORD. 587 = STARTTLS, 465 = TLS. A server without TLS is refused.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
