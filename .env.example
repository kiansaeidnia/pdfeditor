# Copy to .env and fill in. Docker Compose reads it automatically. Never commit .env.

# Where the app listens. 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (set AUTH_PASSWORD first).
BIND=127.0.0.1
PORT=8080

# Login for the whole app. Empty password = no login.
AUTH_USER=admin
AUTH_PASSWORD=

# Optional: e-mail results as attachments. Needs AUTH_PASSWORD too, so strangers cannot send mail as you.
# Port 587 uses STARTTLS, port 465 uses TLS from the start. A server without TLS is refused.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
