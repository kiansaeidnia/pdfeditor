# Copy to .env and fill in. Docker Compose reads it automatically. Never commit .env.

# Where the app listens. 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (choose accounts in setup first).
BIND=127.0.0.1
PORT=8080

# Everything else is chosen in the browser the first time pdfeditor starts. These are optional.

# Password of the bundled Postgres (docker compose --profile postgres up -d). Set it before its first start.
POSTGRES_PASSWORD=change-me

# Fix where accounts and files are kept, so the setup doesn't ask. Useful when you deploy with secrets.
# DATABASE_URL=postgresql://user:password@host:5432/pdfeditor
# S3_BUCKET=
# S3_ENDPOINT=          # empty for Amazon S3; https://<account>.r2.cloudflarestorage.com for R2, etc.
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
