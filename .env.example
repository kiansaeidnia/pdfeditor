# Copy to .env and fill in. Docker Compose reads it automatically. Never commit .env.

# Where the app listens. 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (choose accounts in setup first).
BIND=127.0.0.1
PORT=8080

# Everything else is chosen in the browser the first time pdfeditor starts. The rest of this file is optional.

# --- Bundled Postgres and S3 storage --------------------------------------------------------------------------
# To keep accounts in Postgres and users' files in S3-compatible storage, both running next to the app, uncomment
# this block and change the two passwords (before the first start: they are set when the volumes are created).
# The setup then shows them as fixed instead of asking. Use just one of the two by leaving the other's lines out.
#
# COMPOSE_PROFILES=postgres,s3
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://pdfeditor:${POSTGRES_PASSWORD}@postgres:5432/pdfeditor
# S3_BUCKET=pdfeditor
# S3_ENDPOINT=http://s3:7070
# S3_ACCESS_KEY=pdfeditor
# S3_SECRET_KEY=change-me

# --- Your own Postgres or S3 ----------------------------------------------------------------------------------
# Or point at ones you already run (or type them into the setup instead):
# DATABASE_URL=postgresql://user:password@host:5432/pdfeditor
# S3_BUCKET=
# S3_ENDPOINT=          # empty for Amazon S3; https://<account>.r2.cloudflarestorage.com for R2, etc.
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
